# ==============================================================================
# Alert Webhook Notifier (v1.2.0) 环境变量配置模板
# 复制本文件为 .env 后按需修改: cp .env.example .env
# 留空的环境变量不会覆盖 config.yaml 中的配置
# ==============================================================================

# --- Docker Compose 端口与时区 ---
# 宿主机暴露端口（容器内部固定监听 18082）
ALERT_WEBHOOK_HOST_PORT=18082
# 容器时区
TZ=Asia/Shanghai

# --- 安全认证（可选） ---
# 若设置非空值，访问 Web 控制台 API (/api/*) 时需提供 Authorization: Bearer <token> 或 X-API-Token
# /webhook-alert、/healthz、/readyz 及静态页面不受此限制
ALERT_WEBHOOK_AUTH_TOKEN=

# --- 通知渠道 Webhook URL（可选，设置后将覆盖配置文件对应渠道并自动启用） ---
# 企业微信机器人: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
ALERT_WEBHOOK_WECHAT_URL=
# 钉钉机器人: https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
ALERT_WEBHOOK_DINGTALK_URL=
# 飞书机器人: https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
ALERT_WEBHOOK_FEISHU_URL=

# --- ClickHouse 大流量告警（可选） ---
ALERT_WEBHOOK_TRAFFIC_ENABLED=
ALERT_WEBHOOK_CLICKHOUSE_HOST=
ALERT_WEBHOOK_CLICKHOUSE_PORT=
ALERT_WEBHOOK_CLICKHOUSE_DB=
ALERT_WEBHOOK_CLICKHOUSE_USER=
ALERT_WEBHOOK_CLICKHOUSE_PASSWORD=

# --- Kafka 消费者组积压监控（可选） ---
ALERT_WEBHOOK_KAFKA_ENABLED=
ALERT_WEBHOOK_KAFKA_UI_URL=
ALERT_WEBHOOK_KAFKA_CLUSTER=

# --- 二进制/源码本地运行路径覆盖（Docker Compose 中已由容器默认设置，无需在此配置） ---
# ALERT_WEBHOOK_CONFIG=./config.yaml
# ALERT_WEBHOOK_PORT=0.0.0.0:18082
# ALERT_WEBHOOK_DATA_DIR=./data
# ALERT_WEBHOOK_LOG_DIR=./logs
